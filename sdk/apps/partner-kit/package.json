{
  "name": "@pistiva/partner-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Pistiva node for one business: gateway, task inbox/outbox, approvals queue, disclosure settings and connectors",
  "scripts": {
    "start": "tsx server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@pistiva/agent-sdk": "*",
    "@pistiva/gateway": "*",
    "@pistiva/llm": "*",
    "@pistiva/p2p": "*",
    "@pistiva/procurement": "*",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7"
  }
}
