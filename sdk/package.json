{
  "name": "pistiva-sdk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "keygen": "tsx scripts/keygen.ts",
    "nodes": "tsx scripts/nodes.ts",
    "eval": "tsx scripts/eval.ts",
    "certify": "tsx packages/certify/src/cli.ts"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "werift": "^0.25.0"
  }
}
